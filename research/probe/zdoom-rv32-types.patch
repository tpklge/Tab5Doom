+        FString path = dir;
+        if (path.Len() > 0 && path[path.Len() - 1] != '/') path += "/";
+        path += entry->d_name;
+        struct stat info;
+        if (stat(path.GetChars(), &info) == 0 && S_ISREG(info.st_mode))
+            D_AddFile(wadfiles, path.GetChars());
+    }
